/*# sourceURL=global-styles-inline-css */</style><style id="wor-reader-main-inline-css">.wor-home .wor-home-fire{display:inline-grid;place-items:center;width:31px;height:36px;flex:0 0 31px;overflow:visible;background:none;color:var(--wor-accent)}
.wor-home .wor-home-fire svg{display:block;width:29px;height:35px;max-width:29px;max-height:35px}
.wor-home .wor-home-fire__outer{fill:currentColor}.wor-home .wor-home-fire__inner{fill:color-mix(in srgb,currentColor 58%,white)}
.wor-home .wor-popular-card__read svg{display:block;width:18px;height:18px;max-width:18px;max-height:18px;flex:0 0 18px;fill:currentColor}
.wor-home .wor-latest-stat svg{display:block;width:15px;height:15px;max-width:15px;max-height:15px;flex:0 0 15px;fill:none;stroke:currentColor}
.wor-home .wor-latest-stat--rating svg{fill:currentColor;stroke:currentColor}
.wor-home .wor-popular-showcase__frame{overflow:hidden}
.wor-home .wor-popular-rail{display:grid;grid-auto-flow:column;grid-auto-columns:min(68vw,280px);gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;padding:8px 16vw 12px;scrollbar-width:none}
.wor-home .wor-popular-rail::-webkit-scrollbar{display:none}
.wor-home .wor-popular-card{min-width:0;scroll-snap-align:center}
.wor-home .wor-popular-card__media{position:relative;overflow:hidden;aspect-ratio:2/3;border-radius:22px;background:var(--wor-surface-soft,#111827)}
.wor-home .wor-popular-card__cover{position:absolute;inset:0;display:block;width:100%;height:100%;border:0}
.wor-home .wor-popular-card__cover .wor-cover-img,.wor-home .wor-popular-card__cover .wor-cover-fallback{display:block;width:100%;height:100%;object-fit:cover}
.wor-home .wor-popular-card__actions{position:absolute;z-index:5;left:10px;right:10px;bottom:12px;display:grid;justify-items:center;gap:7px;pointer-events:none}
.wor-home .wor-popular-card__read{display:inline-flex;align-items:center;justify-content:center;gap:7px;width:min(100%,172px);min-height:42px;padding:8px 14px;border-radius:999px;pointer-events:auto;color:#fff;background:var(--wor-accent,#60a5fa)}
.wor-home .wor-popular-card__status{display:inline-flex;align-items:center;gap:6px;max-width:94%;min-height:27px;padding:5px 10px;border-radius:999px;color:#fff;background:rgba(15,23,42,.82);font-size:.72rem;white-space:nowrap}
.wor-home .wor-popular-card__status i{display:block;width:7px;height:7px;border-radius:50%;background:currentColor}
.wor-home .wor-popular-card__status--ongoing{color:#22c55e}.wor-home .wor-popular-card__status--completed{color:#ef4444}.wor-home .wor-popular-card__status--hiatus{color:#f97316}
